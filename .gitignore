# ---------------------------------------------------------------
# .gitignore del repositorio de PSP (todas las unidades)
# Cada proyecto Gradle conserva además su propio .gitignore.
# ---------------------------------------------------------------

# Compilaciones y cachés de Gradle / Kotlin
.gradle/
build/
.kotlin/
out/
!gradle/wrapper/gradle-wrapper.jar

# Configuración local del IDE (IntelliJ IDEA / Android Studio)
.idea/
*.iml
*.ipr
*.iws

# Configuración local de Android
local.properties
.cxx/
.externalNativeBuild/
captures/
*.apk
*.aab

# Datos generados por las prácticas (se regeneran al ejecutarlas)
UT1/procesos/datos/
UT1/procesos/historial.txt

# Sistema operativo y editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/
*.log
*.tmp
